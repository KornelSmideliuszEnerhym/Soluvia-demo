<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    controllerName="soluvia.controller.View"
    xmlns:f="sap.f"
    xmlns:c="sap.ui.core"
    id="IdView"
    height="100%"
>
    <f:DynamicPage
        id="dynamicPageId"
        headerExpanded="{/headerExpanded}"
        toggleHeaderOnTitleClick="{/titleClickable}"
    >
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle>
                <f:content>
                    <Title text="{i18n>userTasksTileTitle}"/>
                </f:content>
                <f:content>
                    <OverflowToolbar>
                        <!-- Waiting -->
                        <GenericTag
                            text="{i18n>CountTag}"
                            status="Information"
                            design="StatusIconHidden"
                            id="idCountTag"
                        >
                            <ObjectNumber
                                number="{statusModel>/numberOfLines}"
                                emphasized="false"
                            />
                        </GenericTag>
                        <GenericTag
                            text="{i18n>ErrorCount}"
                            status="Error"
                            design="StatusIconHidden"
                            id="idErrorTag"
                        >
                            <ObjectNumber
                                number="{statusModel>/numberOfError}"
                                emphasized="false"
                            />
                        </GenericTag>
                        <GenericTag
                            text="{i18n>WarningCount}"
                            status="Warning"
                            design="StatusIconHidden"
                            id="idWarningCountTag"
                        >
                            <ObjectNumber
                                number="{statusModel>/numberOfWarning}"
                                emphasized="false"
                            />
                        </GenericTag>
                        <GenericTag
                            text="{i18n>SuccessCount}"
                            status="Success"
                            design="StatusIconHidden"
                            id="idSuccessCountTag"
                        >
                            <ObjectNumber
                                number="{statusModel>/numberOfSuccess}"
                                emphasized="false"
                            />
                        </GenericTag>
                    </OverflowToolbar>
                    <OverflowToolbar>
                        <VariantManagement
                            id="IdVariantManagement"
                            select="onSelectVariant"
                            showFooter="false"
                            popoverTitle="Variants list"
                            selectedKey="0"
                        >
                            <items>
                                <VariantItem
                                    key="0"
                                    title="Default"
                                    rename="false"
                                    sharing="Public"
                                />
                                <VariantItem
                                    key="1"
                                    title="Variant 1"
                                    rename="false"
                                    sharing="Public"
                                />
                                <VariantItem
                                    key="2"
                                    title="Variant 2"
                                    rename="false"
                                    sharing="Public"
                                />
                            </items>
                        </VariantManagement>
                    </OverflowToolbar>
                </f:content>
            </f:DynamicPageTitle>
        </f:title>
        <!-- DynamicPage Header -->
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox
                    class="sapUiTinyMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <VBox
                        class="sapUiTinyMarginTop"
                        width="48%"
                    >
                        <Label text="{i18n>SYSID}" />
                        <Input
                            id="IdSysidInput"
                            class="taskInputClass"
                            placeholder="{i18n>TicketInputPlaceholder}"
                        />
                    </VBox>
                    <VBox
                        class="sapUiTinyMarginTop"
                        width="48%"
                    >
                        <Label text="{i18n>BUKRS}" />
                        <Input
                            id="IdBukrsInput"
                            class="taskInputClass"
                            placeholder="{i18n>TicketInputPlaceholder}"
                        />
                    </VBox>
                </HBox>
                <HBox
                    class="sapUiTinyMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <VBox
                        class="sapUiTinyMarginTop"
                        width="48%"
                    >
                        <Label text="{i18n>TCODE}" />
                        <Input
                            id="IdTcodeInput"
                            class="taskInputClass"
                            placeholder="{i18n>TicketInputPlaceholder}"
                        />
                    </VBox>
                    <VBox
                        class="sapUiTinyMarginTop"
                        width="48%"
                    >
                        <Label text="{i18n>DATUM}" />

                        <DatePicker
                            width="100%"
                            id="IdDatumInput"
                            placeholder="{i18n>EnterDate}"
                        />
                    </VBox>
                </HBox>
                <HBox
                    class="sapUiTinyMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <VBox
                        class="sapUiTinyMarginTop"
                        width="48%"
                    >
                        <Label text="{i18n>UNAME}" />
                        <Input
                            id="IdUnameInput"
                            class="taskInputClass"
                            placeholder="{i18n>TicketInputPlaceholder}"
                        />
                    </VBox>
                    <VBox
                        class="sapUiTinyMarginTop"
                        width="48%"
                    >
                        <Label text="{i18n>INFO}" />
                        <Input
                            id="IdInfoInput"
                            class="taskInputClass"
                            placeholder="{i18n>TicketInputPlaceholder}"
                        />
                    </VBox>
                </HBox>
                <HBox
                    class="sapUiTinyMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <VBox
                        class="sapUiTinyMarginTop"
                        width="48%"
                    >
                        <Button
                            id="idSearchBtn"
                            text="{i18n>Search}"
                            press="onSearch"
                        />
                    </VBox>
                    <VBox
                        class="sapUiTinyMarginTop"
                        width="48%"
                        direction="Row"
                    >
                        <CheckBox
                            text="{i18n>Error}"
                            valueState="Error"
                            id="IdErrorCheckBox"
                            selected="true"
                        />
                        <CheckBox
                            text="{i18n>Warning}"
                            valueState="Warning"
                            id="IdWarningCheckBox"
                            selected="false"
                        />
                        <CheckBox
                            text="{i18n>Success}"
                            valueState="Success"
                            id="IdSuccessCheckBox"
                            selected="false"
                        />
                    </VBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <!-- InfoLabel component into table row -->
            <Table
                id="idTaskTable"
                sticky="HeaderToolbar,ColumnHeaders"
                inset="false"
                class="sapFDynamicPageAlignContent"
                width="auto"
                items="{resultModel>/}"
                autoPopinMode="true"
                noDataText="{i18n>NotFound}"
            >
                <columns>
                    <Column hAlign="Center">
                        <header>
                            <Text text="{i18n>SYSID}" />
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <Text text="{i18n>BUKRS}" />
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <Text text="{i18n>TCODE}" />
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <Text text="{i18n>Z_ID}" />
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <Text text="{i18n>DATUM}" />
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <Text text="{i18n>UZEIT}" />
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <Text text="{i18n>UNAME}" />
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <Text text="{i18n>STATUS}" />
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <Text text="{i18n>Info}" />
                        </header>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <ObjectIdentifier text="{resultModel>Sysid}" />
                        <ObjectIdentifier text="{resultModel>Bukrs}" />
                        <ObjectIdentifier text="{resultModel>Tcode}" />
                        <ObjectIdentifier text="{resultModel>Z_Id}" />
                        <ObjectIdentifier
                            text="{ path: 'resultModel>Datum', formatter: '.formatDate' }"
                        />
                        <ObjectIdentifier
                            text="{ path: 'resultModel>Uzeit', formatter: '.formatTime' }"
                        />
                        <ObjectIdentifier text="{resultModel>Uname}" />
                        <c:Icon
                            src="{= ${resultModel>Status} === 'SUCCESS' ? 'sap-icon://lightbulb' : 
                                    ${resultModel>Status} === 'WARNING' ? 'sap-icon://lightbulb' :
                                    ${resultModel>Status} === 'ERROR'   ? 'sap-icon://lightbulb' : 'sap-icon://lightbulb' }"
                            color="{= ${resultModel>Status} === 'SUCCESS' ? 'Positive' :
                                      ${resultModel>Status} === 'WARNING' ? 'Critical' : 
                                      ${resultModel>Status} === 'ERROR'   ? 'Negative' : 'Neutral' }"
                        />
                        <ObjectIdentifier text="{resultModel>Info}" />
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
